{"nodes": [{"id": "docs_ats_application_copilot_poc_spec_poc", "label": "ATS Application Copilot POC Specification", "file_type": "document", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ats_application_copilot_poc_spec_side_panel", "label": "Side-Panel Application Assistant", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ats_application_copilot_poc_spec_workspace", "label": "Full-Page Extension Workspace", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ats_application_copilot_poc_spec_scan_match_tailor_fill_confirm", "label": "Scan-Match-Tailor-Fill-Confirm Journey", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ats_application_copilot_poc_spec_deterministic_scoring", "label": "Deterministic Match Scoring", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scoring is deterministic and explainable so an LLM never directly chooses the final numeric score; a deterministic aggregator owns the number and validators stay authoritative over agent output, keeping results reproducible and defensible rather than an opaque ATS prediction."}, {"id": "docs_ats_application_copilot_poc_spec_truth_constrained_tailoring", "label": "Truth-Constrained Tailoring", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every generated resume statement must reference verified sourceFactIds; the model may rephrase/reorder/emphasize/omit verified content but may never invent employers, dates, skills or metrics, so NEW_CLAIM proposals are rejected by default to preserve candidate truthfulness."}, {"id": "docs_ats_application_copilot_poc_spec_docling_parsing", "label": "Docling Document Parsing", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Docling is the only document-intelligence library in the POC; a second parser (OpenDataLoader, Marker, PyMuPDF, pdfplumber) is forbidden until benchmark evidence justifies it, avoiding premature dependency sprawl."}, {"id": "docs_ats_application_copilot_poc_spec_candidate_facts", "label": "Verified Candidate Facts", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ats_application_copilot_poc_spec_fact_verification", "label": "Candidate Fact Verification with A4 Source", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Profile verification shows the rendered uploaded resume as paginated A4 source pages alongside extracted facts so users can compare extraction with source before facts become verified; unverified facts cannot support generated claims."}, {"id": "docs_ats_application_copilot_poc_spec_fill_plan", "label": "Approved Immutable Fill Plan", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI output never manipulates the page directly; the service worker executes only a schema-validated, user-approved immutable fill plan through an ATS adapter, and editing a value creates a new proposed version requiring re-approval."}, {"id": "docs_ats_application_copilot_poc_spec_ats_adapter", "label": "ATS Adapter Contract", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Page-specific ATS logic is kept out of the UI behind a capability-based adapter contract; unsupported capabilities degrade to clear manual instructions rather than guessed automation."}, {"id": "docs_ats_application_copilot_poc_spec_generic_adapter", "label": "GenericAdapter", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ats_application_copilot_poc_spec_greenhouse_adapter", "label": "GreenhouseAdapter", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Greenhouse is the first ATS-specific adapter; Ashby and Workday are deferred until volume justifies the maintenance cost."}, {"id": "docs_ats_application_copilot_poc_spec_zustand_store", "label": "Zustand UI/Workflow Store", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zustand is an in-memory projection per React surface, not a cross-context database; Chrome storage and IndexedDB remain the durable repositories so service-worker suspension or a closed tab never destroys an application record."}, {"id": "docs_ats_application_copilot_poc_spec_repository_layer", "label": "Repository Layer (Session/Document)", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ats_application_copilot_poc_spec_service_worker", "label": "Extension Service Worker", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ats_application_copilot_poc_spec_content_script", "label": "Content Script", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ats_application_copilot_poc_spec_fastapi_backend", "label": "FastAPI Backend", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ats_application_copilot_poc_spec_ai_provider", "label": "AI Provider Interface", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One internal provider interface with server-side credentials and a model allowlist; provider failure never silently falls back to another provider, and provider/model provenance is recorded on every AI-assisted artifact."}, {"id": "docs_ats_application_copilot_poc_spec_openai_provider", "label": "OpenAIProvider", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ats_application_copilot_poc_spec_ollama_provider", "label": "OllamaProvider", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ats_application_copilot_poc_spec_job_analyst_agent", "label": "JobAnalystAgent", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ats_application_copilot_poc_spec_candidate_evidence_agent", "label": "CandidateEvidenceAgent", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ats_application_copilot_poc_spec_tailoring_agent", "label": "TailoringAgent", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ats_application_copilot_poc_spec_critic_agent", "label": "CriticAgent", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CriticAgent reviews each tailoring proposal for relevance, semantic drift, and unsupported claims before deterministic validation, but critic approval never overrides schema, sourceFactIds, classification, or truth validators."}, {"id": "docs_ats_application_copilot_poc_spec_application_identity", "label": "Application Identity (applicationId/jobFingerprint/tabId)", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An application has a durable applicationId and jobFingerprint (normalized company+title+location+URL); a Chrome tabId is only a temporary browser binding, so a reopened tab reconnects to the durable record without creating duplicates."}, {"id": "docs_ats_application_copilot_poc_spec_trust_boundary", "label": "Untrusted Page-Content Trust Boundary", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Job-page content, labels, hidden DOM text, JSON-LD and application questions are untrusted data never instructions; content is sanitized and delimited before AI use so embedded instructions cannot change system behavior (prompt-injection defense)."}, {"id": "docs_ats_application_copilot_poc_spec_a4_pdf_generation", "label": "A4 Preview and PDF Generation", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The exact same generated HTML/CSS drives both the sandboxed A4 preview and Playwright PDF generation to avoid preview/PDF drift, using a single ATS-safe template in the POC."}, {"id": "docs_ats_application_copilot_poc_spec_never_invent_facts", "label": "Never Invent Candidate Facts Principle", "file_type": "rationale", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A locked product decision: the system must never invent candidate facts and sensitive demographic answers are never inferred; deterministic truth validators remain authoritative over all agent output across scoring, tailoring, and filling."}, {"id": "docs_ats_application_copilot_poc_spec_user_control_submission", "label": "User-Controlled Final Submission Principle", "file_type": "rationale", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The extension never automatically clicks the final Submit button; the user preserves control over all generated content and form filling, and final submission always remains a user action on the portal."}, {"id": "docs_ats_application_copilot_poc_spec_phase_1", "label": "Phase 1: Extension UI with Mock Data", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ats_application_copilot_poc_spec_phase_2", "label": "Phase 2: Backend Intelligence and Integration", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ats_application_copilot_poc_spec_phase_3", "label": "Phase 3: Browser Integration and Filling", "file_type": "concept", "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_ats_application_copilot_poc_spec_poc", "target": "docs_ats_application_copilot_poc_spec_side_panel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "weight": 1.0}, {"source": "docs_ats_application_copilot_poc_spec_poc", "target": "docs_ats_application_copilot_poc_spec_workspace", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ATS_APPLICATION_COPILOT_POC_SPEC.md", "source_location": null, "weight": 1.0}, {"source": "docs_ats_application_copilot_poc_spec_side_panel", "target": "docs_ats_application_copilot_poc_spec_scan_match_tailor_fill_confirm", "relation": "references", "confidence": "EXTRACTED", "confi